# The site address comes from an environment variable so the same config
# works locally (set DOMAIN=localhost) and in production (set DOMAIN to
# the real domain). Caddy issues a Let's Encrypt certificate automatically
# for any public hostname, and uses its internal CA for localhost.
{$DOMAIN} {
	# API calls keep the /api prefix. The backend controllers are all
	# mapped under /api, so the prefix must reach the backend untouched.
	# handle (not handle_path) passes the path through as-is.
	handle /api/* {
		# The API only takes small JSON bodies, the largest being a workout
		# plan. Anything over 1 MB is refused with 413 here, before it
		# reaches the backend. Caddy is the only way in, since the backend
		# publishes no port.
		request_body {
			max_size 1MB
		}

		reverse_proxy backend:8080
	}

	# Everything else is the Angular single-page app.
	handle {
		root * /srv

		# Client-side routing means deep links like /workouts have no
		# matching file on disk. Serve the requested file when it exists,
		# otherwise fall back to index.html and let the Angular router
		# take over.
		try_files {path} /index.html

		file_server
	}

	# Security headers for every response, the SPA and the API proxy alike.
	# The app keeps its JWT in localStorage, so the CSP is what limits damage from
	# an injected script: nothing but same-origin scripts may run, and the page can
	# only talk to its own origin. 'unsafe-inline' is allowed for styles only,
	# Angular emits component styles inline. HSTS has no includeSubDomains or
	# preload on purpose, those are hard to undo if another subdomain lacks HTTPS.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Compress text responses. Caddy picks zstd or gzip based on what
	# the client accepts.
	encode zstd gzip
}
