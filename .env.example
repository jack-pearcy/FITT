FITT_DB_NAME=fitt
FITT_DB_USERNAME=fitt
FITT_DB_PASSWORD=change-me
FITT_DB_ROOT_PASSWORD=change-me-too
FITT_JWT_SECRET_VALUE=replace-with-a-secret-at-least-32-characters-long
FITT_JWT_ISSUER=fitt-api
FITT_JWT_TTL_SECONDS=3600

# Public hostname Caddy serves and requests a certificate for.
# Set to localhost for local verification, or your real domain in production.

# Origins allowed to call the API from a browser, comma separated. Same-origin
# requests through Caddy do not need CORS, this matters for other clients.
# Local verification: https://localhost. Production: https://example.com
FITT_CORS_ALLOWED_ORIGINS=https://localhost

# Production only (docker-compose.prod.yml). The deploy workflow rewrites
# IMAGE_TAG on the server for each deploy.
# IMAGE_OWNER is the lowercase GitHub owner that publishes the GHCR images.
IMAGE_OWNER=github-owner
IMAGE_TAG=latest-commit-sha
