<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="backend"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- %X{requestId} reads the correlation ID from MDC, default = dash -->
            <!-- Prints a dash when no request is in flight, during startup. -->
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5level [${appName}] [%15.15t] [%X{requestId:--}] %-40.40logger{39} : %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>